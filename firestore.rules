rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'createdAt']) 
        && data.keys().size() == 3
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 50
        && data.score is number && data.score >= 0 && data.score <= 1000
        && data.createdAt == request.time;
    }

    match /leaderboard/{entryId} {
      // Anyone can read the leaderboard (to show top scores)
      allow read: if true; 

      allow create: if isValidId(entryId)
        && isValidLeaderboardEntry(incoming());
        
      allow update: if false; // Scores are immutable
      allow delete: if false;
    }
  }
}
